<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/main_background">

    <RelativeLayout
        android:id="@+id/layout_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_alignParentBottom="true"
        android:background="#0D110A"
        android:paddingHorizontal="24dp">

        <TextView
            android:id="@+id/tv_total_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:fontFamily="serif"
            android:text="Rp 48.000"
            android:textColor="@color/off_white"
            android:textSize="20sp" />

        <android.widget.Button
            android:id="@+id/btn_place_order"
            android:layout_width="160dp"
            android:layout_height="50dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/button_rounded"
            android:backgroundTint="#739A4D"
            android:text="Place Order"
            android:textAllCaps="false"
            android:textColor="#131711"
            android:textSize="14sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/layout_bottom_bar"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="40dp">

            <ImageButton
                android:id="@+id/btn_back_to_menu"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_circle_outline"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_arrow_back"
                app:tint="#A0A0A0" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="250dp"
                android:layout_marginTop="24dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">
                <ImageView
                    android:id="@+id/iv_product_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/card_product_1" />
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/tv_item_category"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:letterSpacing="0.2"
                android:text="DRINK"
                android:textColor="@color/gold_matcha"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_item_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="serif"
                android:text="Iced Matcha Latte"
                android:textColor="@color/off_white"
                android:textSize="28sp" />

            <TextView
                android:id="@+id/tv_item_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Layered. Cold-brewed. Quietly perfect."
                android:textColor="@color/subtitle_grey"
                android:textSize="14sp" />

            <View
                android:layout_width="40dp"
                android:layout_height="1dp"
                android:layout_marginVertical="16dp"
                android:background="@color/gold_matcha" />

            <TextView
                android:id="@+id/tv_item_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lineSpacingMultiplier="1.2"
                android:text="Deskripsi Produk..."
                android:textColor="#A0A0A0"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_item_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="serif"
                android:text="Rp 48.000"
                android:textColor="@color/off_white"
                android:textSize="20sp" />

            <LinearLayout
                android:id="@+id/layout_ice_sweet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:letterSpacing="0.1"
                    android:text="ICE LEVEL"
                    android:textColor="@color/gold_matcha"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Spinner
                        android:id="@+id/spinner_ice_level"
                        android:layout_width="0dp"
                        android:layout_height="45dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_box_outline"
                        android:paddingHorizontal="12dp"
                        android:popupBackground="#131711" />

                    <Spinner
                        android:id="@+id/spinner_sweet_level"
                        android:layout_width="0dp"
                        android:layout_height="45dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_box_outline"
                        android:paddingHorizontal="12dp"
                        android:popupBackground="#131711" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:letterSpacing="0.1"
                android:text="QUANTITY"
                android:textColor="@color/gold_matcha"
                android:textSize="10sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/et_quantity"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_box_outline"
                android:hint="How many would you like?"
                android:inputType="number"
                android:paddingHorizontal="16dp"
                android:textColor="@color/off_white"
                android:textColorHint="#666666"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:letterSpacing="0.1"
                android:text="NOTES - optional"
                android:textColor="@color/gold_matcha"
                android:textSize="10sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/et_notes"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_box_outline"
                android:gravity="top|start"
                android:hint="Any special requests?"
                android:inputType="textMultiLine"
                android:padding="16dp"
                android:textColor="@color/off_white"
                android:textColorHint="#666666"
                android:textSize="12sp" />

        </LinearLayout>
    </ScrollView>
</RelativeLayout>